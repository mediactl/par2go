       // If the next match fails, assume we hare half way through scanning for the next block
       scanoffset = scandistance >> 1;
 
@@ -1884,6 +1916,19 @@ bool Par2Repairer::ScanDataFile(DiskFile                *diskfile,    // [in]
         if (!filechecksummer.Step())
