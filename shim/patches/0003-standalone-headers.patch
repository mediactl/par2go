par2go patch to par2cmdline-turbo v1.5.0-20261005 (GPL-2.0-or-later, as upstream).

libpar2.h includes <config.h>, <inttypes.h> and <string.h> inside
namespace Par2. Upstream's own sources get away with it because their
precompiled header includes those first; a library user who includes a
par2 header first gets libc declared in Par2:: and a failed build. Include
them before the namespace opens.

diff --git a/include/par2/libpar2.h b/include/par2/libpar2.h
index 4f1ca3a..0e5b0a5 100644
--- a/include/par2/libpar2.h
+++ b/include/par2/libpar2.h
@@ -25,6 +25,21 @@
 #include <string>
 #include <cstdint>
 
+// The system headers included inside namespace Par2 below would declare
+// their contents in Par2:: if nothing had included them first, which only
+// upstream's own precompiled header guarantees. Include them here so a
+// library user may include this header first. (par2go patch; offered
+// upstream.)
+#ifdef HAVE_CONFIG_H
+#include <config.h>
+#if HAVE_INTTYPES_H
+#  include <inttypes.h>
+#endif
+#endif
+#ifndef _WIN32
+#  include <string.h>
+#endif
+
 namespace Par2
 {
 
